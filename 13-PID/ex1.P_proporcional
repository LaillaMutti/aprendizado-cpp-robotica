#include <Arduino.h>
//pinos digitais
int sensorE = 2; int sensorM = 13; int sensorD = 12; 

int valorDesejado = 0; int velocidadeBase = 255; 

int FrenteMotorE = 5; int TrasMotorE = 6; int FrenteMotorD = 9; int TrasMotorD = 4;

int enableE = 11; int enableD = 3;

float posicao; float erro;

int kp = 20; float pos; int P;

int valorE; int valorM; int valorD; 

float calculoPosicao(float valorE, float valorM, float valorD) {
    // soma dos sensores
    float pos = valorE + valorM + valorD;

    if (pos == 0) return 0; // evita divisão por zero

    // média ponderada
     return //((valorEE * -2) + 
              ((valorE * -1) + 
              (valorM * 0) + 
              (valorD * 1)) / pos; 
              //(valorED * 2)) / pos;
}
float calculoErro(float posicao){
  return valorDesejado - posicao;
}
float proporcional(float erro){
  return kp * erro;
}
void frente(){
    analogWrite(enableE, velocidadeBase);
    analogWrite(enableD, velocidadeBase);
    digitalWrite(FrenteMotorD, HIGH);
    digitalWrite(TrasMotorD, LOW);
    digitalWrite(FrenteMotorE, HIGH);
    digitalWrite(TrasMotorE, LOW);
}
void esquerda(){
    analogWrite(enableE, velocidadeBase);
    analogWrite(enableD, velocidadeBase);
    analogWrite(enableE, velocidadeBase);
    analogWrite(enableD, velocidadeBase);
    digitalWrite(FrenteMotorD, LOW);
    digitalWrite(TrasMotorD, HIGH);
    digitalWrite(FrenteMotorE, HIGH);
    digitalWrite(TrasMotorE, LOW); 
}
void direita(){
    analogWrite(enableE, velocidadeBase);
    analogWrite(enableD, velocidadeBase); 
    analogWrite(enableE, velocidadeBase);
    analogWrite(enableD, velocidadeBase);
    digitalWrite(FrenteMotorD, HIGH);
    digitalWrite(FrenteMotorE, LOW);
    digitalWrite(TrasMotorD, LOW);
    digitalWrite(TrasMotorE, HIGH);
}
void setup(){
  pinMode(sensorE, INPUT); pinMode(sensorM, INPUT); pinMode(sensorD, INPUT);

  pinMode(enableE, OUTPUT); pinMode(enableD, OUTPUT);

  pinMode(FrenteMotorD, OUTPUT); pinMode(TrasMotorD, OUTPUT); pinMode(FrenteMotorE, OUTPUT); pinMode(TrasMotorE, OUTPUT);
  Serial.begin(9600);
}

void loop() {
  //valorEE = digitalRead(sensorEE);
  Serial.println(digitalRead(sensorD));
  
  valorE = digitalRead(sensorE);
  valorM = digitalRead(sensorM);
  valorD = digitalRead(sensorD);
  //valorED = digitalRead(sensorED);
  posicao = calculoPosicao(valorE, valorM, valorD);
  erro = calculoErro(posicao);
  P = proporcional(erro);

  if (P > 0){
    direita();
  }else if(P == 0){
    frente();
  } else if(P<0){
    esquerda();
  }
}
