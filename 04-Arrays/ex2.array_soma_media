float notas[4] = {7, 6, 8, 9};
int quantidade;
float media;
float soma = 0;

void calculo(float &soma){
  quantidade = sizeof(notas)/sizeof(notas[0]);
  media = soma / quantidade;
  Serial.println("A média de notas é: ");
  Serial.println(media);
}

void setup(){
 Serial.begin(9600);
 for (int i=0; i<4; i++){
     soma = soma + notas[i];
  }
  calculo(soma);
}

