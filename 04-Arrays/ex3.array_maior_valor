float numeros[3] = {2, 6, 10};
float comparativo = numeros[0];
float maior;

void setup(){
  Serial.begin(9600);
}
void loop(){
  for(int i = 1; i<3; i++){
     if (comparativo > numeros[i]){
         maior = comparativo;
    }else{
        comparativo = numeros[i];
        maior = numeros[i];
       }
     }
  Serial.println("O maior número é o: ");
  Serial.println(maior);
}
