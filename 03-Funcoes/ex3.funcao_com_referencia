//Exercício Plano Cartesiano

int x = 1;
int y = 5;
int tempo = 1000;

void setup(){
}
void andarDireita(int &x){
  x++;
}
void andarEsquerda(int &x){
  x--;
}
void andarCima(int &y){
  y++;
}
void andarBaixo(int &y){
  y--;
}
void voltarInicio(int &x, int &y){
  x = 0;
  y = 0;
}

int i;

void loop(){

  for(i=1; i<5; i++){
    andarEsquerda(x);
    delay(tempo);
 }
 for(i=1; i<6; i++){
   andarCima(y);
   delay(tempo);
 }
}
  
